{
  "name": "echopulse-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=server/**",
    "benchmark": "node --test tests/submissionScenarios.test.js",
    "benchmark:submission": "node tests/submissionBenchmark.mjs",
    "verify": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "test:rules": "npx --yes --package=firebase-tools@15.37.0 -- firebase emulators:exec --project demo-ecopulse --only auth,firestore \"node --test tests/firestoreRules.emulator.mjs\"",
    "test:meetups-ui": "node --test tests/meetups.browser.mjs",
    "test:browser": "node --test tests/meetups.browser.mjs tests/cleanAir.browser.mjs tests/vision.browser.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "4.3.2",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.79.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.1",
    "oxlint": "^1.90.0",
    "playwright-core": "1.65.1",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^24.12.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.7"
    }
  }
}
