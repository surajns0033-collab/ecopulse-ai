{
  "framework": "vite",
  "redirects": [
    { "source": "/talk", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://ecopulse-ai-5e86e.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://ecopulse-ai-5e86e.firebaseapp.com/__/firebase/:path*"
    },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
