# EcoPulse AI — Environment Variables
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------
# AI PROVIDER (server-side; used by the /api/ai proxy in vite.config.js)
# ---------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Leave blank to auto-select the best available Gemini flash model
GEMINI_MODEL=

# Optional zero-cost chat fallback: https://openrouter.ai/keys
# Uses only the OpenRouter free-model router (default: openrouter/free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional grounded web search (1,000 free credits/month): https://app.tavily.com
TAVILY_API_KEY=

# Optional: any OpenAI-compatible gateway (OpenRouter, Together, local vLLM, etc.)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OpenWeatherMap API Key (optional — Open-Meteo is used as a free fallback)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# WAQI / World Air Quality Index API Token (optional — Open-Meteo AQ is a free fallback)
VITE_WAQI_TOKEN=your_waqi_token

# Google Maps API Key (Optional — enables Google Geocoding & Static Maps)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# App Config
VITE_APP_NAME=EcoPulse AI
VITE_APP_VERSION=2.0.0
